       4546                     SUBROUTINE CHAREQ( QL1,QL2,QL3, QR1,QR2,QR3, Bay, Vay )
       4547                     DOUBLE PRECISION :: QL1,QL2,QL3, QR1,QR2,QR3, Bay, Vay
       4548                     double precision :: sqdyp, sqdym, vyp, vym, Byp, Bym
       4549                     
       4550                     vyp   = QL1; vym   = QR1 ; Byp   = QL2; Bym   = QR2
       4551                     sqdyp = dsqrt( QL3 ); sqdym = dsqrt( QR3 )
       4552                     
       4553                     Vay = ( sqdyp*vyp + sqdym*vym + Bym - Byp )/(sqdyp+sqdym)
       4554                     Bay = ( sqdyp*sqdym*(vym-vyp)+sqdyp*Bym+sqdym*Byp )/(sqdyp+sqdym)
       4555                     
       4556                     END SUBROUTINE CHAREQ

