        596                     !***** Alfven wave propagation *****!
        597                     goto 111
        598     3               do k = 1, Ncellz+1; do j = 1, Ncelly+1; do i = 1, Ncellx+1
        599     3                 xpi = 0.5d0*( x(i)+x(i-1) ); amp = 1.d-3
        600     3                 U(i,j,k,3) =  amp*dcos(2.d0*pi*xpi)
        601     3                 U(i,j,k,4) =  amp*dcos(2.d0*pi*xpi)
        602     3                 U(i,j,k,7) = -amp*dsqrt(dinit1)*dcos(2.d0*pi*xpi)
        603     3                 U(i,j,k,8) =  amp*dsqrt(dinit1)*dcos(2.d0*pi*xpi)
        604     3               end do; end do; end do
        605                     111 continue
        606                     !***** Blast wave *****!
        607                     goto 112
        608     3               do k = -1, Ncellz+2; do j = -1, Ncelly+2; do i = -1, Ncellx+2
        609     3                 xpi = 0.5d0*( x(i)+x(i-1) ); ypi = 0.5d0*( y(j)+y(j-1) )
        610     3                 amp = dsqrt( (xpi-0.5d0)**2 + (ypi-0.5d0)**2 )
        611     3                 if(amp.lt.0.125d0) U(i,j,k,5) =  1.d2
        612     3               end do; end do; end do
        613                     112 continue
