       5916     4        m      do k = 1, Ncellz; do j = 1, Ncelly; do i = 1, Ncellx
       5917     4               !----- Cooling ---------------------------------------------------------
       5918     4               !----Fcool---
       5919     4        v        ndHtot = ndH(i,j,k)+ndp(i,j,k)+2.d0*ndH2(i,j,k)+ndHm(i,j,k)
       5920     4               
       5921     4        v        Av1  = 1.63542d-3*Nfgr(i,j,k,1); x1 = 6.1714d3*NH2(i,j,k,1)
       5922     4        v        Av2  = 1.63542d-3*Nfgr(i,j,k,2); x2 = 6.1714d3*NH2(i,j,k,2)
       5923     4        v        ATN1 = ( dexp(-2.5d0*Av1)     + dexp(-2.5d0*Av2) ) * 0.5d0
       5924     4        v        ATN2 = ( dexp(-3.77358d0*Av1) + dexp(-3.77358d0*Av2) ) * 0.5d0
       5925     4        v        pha  = G0 * dsqrt(1.d3*Tn(i,j,k)) * ATN1 / nde(i,j,k)
       5926     4                 !------------------------- Lya Cooling
       5927     4                 !-spitzer
       5928     4        v        Laml = ndH(i,j,k)*nde(i,j,k) * 1.44049d9*dexp( -1.184d2/Tn(i,j,k))
       5929     4        v        Laml = Laml + ndH(i,j,k)**2 * (1.54d8/dsqrt(Tn(i,j,k))+1.305d6*dsqrt(Tn(i,j,k))) * dexp( -1.184d2/Tn(i,j,k) )
       5930     4                 !_________________________ CII Cooling L
       5931     4        v        fesC1 = (0.5d0+dsign(0.5d0,0.1d0-1.d-16-tCII(i,j,k,1)))*(0.5d0-0.585d0*tCII(i,j,k,1)+0.4563d0*tCII(i,j,k,1)**2) &
       5932     4                       + (0.5d0+dsign(0.5d0,11.9025d0-(tCII(i,j,k,1)-3.55d0)**2))*(1.d0-dexp(-2.34d0*tCII(i,j,k,1)))/(4.68d0*tCII(i,j,k,1)+1.d-8) &
       5933     4                       + (0.5d0+dsign(0.5d0,tCII(i,j,k,1)-7.d0))/(4.d0*tCII(i,j,k,1)*dsqrt(dlog(dmax1(tCII(i,j,k,1)*0.56419d0,4.d0)))+1.d-8)
       5934     4        v        fesC2 = (0.5d0+dsign(0.5d0,0.1d0-1.d-16-tCII(i,j,k,2)))*(0.5d0-0.585d0*tCII(i,j,k,2)+0.4563d0*tCII(i,j,k,2)**2) &
       5935     4                       + (0.5d0+dsign(0.5d0,11.9025d0-(tCII(i,j,k,2)-3.55d0)**2))*(1.d0-dexp(-2.34d0*tCII(i,j,k,2)))/(4.68d0*tCII(i,j,k,2)+1.d-8) &
       5936     4                       + (0.5d0+dsign(0.5d0,tCII(i,j,k,2)-7.d0))/(4.d0*tCII(i,j,k,2)*dsqrt(dlog(dmax1(tCII(i,j,k,2)*0.56419d0,4.d0)))+1.d-8)
       5937     4        v        b21 = fesC1+fesC2
       5938     4               
       5939     4        v        c21 = 8.854d-8*nde(i,j,k)/dsqrt(Tn(i,j,k)) + 9.399d-10*(Tn(i,j,k)**0.07d0)*(ndH(i,j,k)+ndH2(i,j,k))
       5940     4        v        c12 = 2.d0*c21*dexp(-0.092d0/Tn(i,j,k))
       5941     4        v        A21 = 2.4d-6*b21
       5942     4        v        n2  = ndCp(i,j,k)*c12/(c12+c21+A21)
       5943     4        v        n1  = ndCp(i,j,k)*(c21+A21)/(c12+c21+A21)
       5944     4               
       5945     4        v        Lamc = 6.0157d7*n2*b21
       5946     4                 !***------------------------- OI Cooling
       5947     4        v        tO1  = 11.6618d0*NO(i,j,k,1) ; tO2 = 11.6618d0*NO(i,j,k,2)
       5948     4        v        fesO1 = (0.5d0+dsign(0.5d0,0.1d0-1.d-16-tO1))*(0.5d0-0.585d0*tO1+0.4563d0*tO1**2) &
       5949     4                       + (0.5d0+dsign(0.5d0,11.9025d0-(tO1-3.55d0)**2))*(1.d0-dexp(-2.34d0*tO1))/(4.68d0*tO1+1.d-8) &
       5950     4                       + (0.5d0+dsign(0.5d0,tO1-7.d0))/(4.d0*tO1*dsqrt(dlog(dmax1(tO1*0.56419d0,4.d0)))+1.d-8)
       5951     4        v        fesO2 = (0.5d0+dsign(0.5d0,0.1d0-1.d-16-tO2))*(0.5d0-0.585d0*tO2+0.4563d0*tO2**2) &
       5952     4                       + (0.5d0+dsign(0.5d0,11.9025d0-(tO2-3.55d0)**2))*(1.d0-dexp(-2.34d0*tO2))/(4.68d0*tO2+1.d-8) &
       5953     4                       + (0.5d0+dsign(0.5d0,tO2-7.d0))/(4.d0*tO2*dsqrt(dlog(dmax1(tO2*0.56419d0,4.d0)))+1.d-8)
       5954     4        v        Lamo = (dmax1(ndO(i,j,k)-ndCO(i,j,k),0.d0)) * ndfgr(i,j,k) / ndO(i,j,k) * (ndH(i,j,k)+0.5d0*ndH2(i,j,k)) * 1.23916d1 * (Tn(i,j,k)**0.4d0) * dexp( -0.228d0/Tn(i,j,k) )
       5955     4        v        Lamo = Lamo * (fesO1+fesO2)
       5956     4                 !***------------------------- DustRec Cooling
       5957     4        v        Lamd = ndfgr(i,j,k)*nde(i,j,k)*6.06236d0 * (Tn(i,j,k)**0.94d0) * ( pha**( 0.462628d0/(Tn(i,j,k)**6.8d-2) ) )
       5958     4                 !***------------------------- Dust-gas-coll. Cooling ---Bialy+19; Draine p.287---
       5959     4        v        Td=1.64d1*(G0/1.7d0)**(1.d0/6.0)
       5960     4        v        Lamdg = ndfgr(i,j,k)*ndtot(i,j,k)*dsqrt(Tn(i,j,k)*1.d3)*3.8d-33*1.9733d27*(Tn(i,j,k)*1.d3-Td)*(1.d0-0.8d0*dexp(-75.d0/(Tn(i,j,k)*1.d3)))
       5961     4                 !***------------------------- CO Cooling
       5962     4        v        ncr  = 3.3d6*(Tn(i,j,k)**0.75d0)/(ndH(i,j,k)+ndp(i,j,k)+ndH2(i,j,k)+ndHe(i,j,k)+ndHep(i,j,k))
       5963     4        v        tau1 = 1.33194d1*NCO(i,j,k,1)/(Tn(i,j,k)*dv); tau2 = 1.33194d1*NCO(i,j,k,2)/(Tn(i,j,k)*dv)
       5964     4        v        ct1  = tau1*dsqrt( 6.283d0*dlog(2.13d0+(tau1*0.36788d0)**2) ); ct2 = tau2*dsqrt( 6.283d0*dlog(2.13d0+(tau2*0.36788d0)**2) )
       5965     4        v        ym1  = dlog( 1.d0+ct1/(1.d0+1.d1*ncr) ); ym2  = dlog( 1.d0+ct2/(1.d0+1.d1*ncr) )
       5966     4        v        fes  = (2.d0+ym1+0.6d0*ym1**2)/(1.d0+ct1+ncr+1.5d0*dsqrt(ncr)) + (2.d0+ym2+0.6d0*ym2**2)/(1.d0+ct2+ncr+1.5d0*dsqrt(ncr))
       5967     4        v        LCOr = ndCO(i,j,k) * 1.91505d10*(Tn(i,j,k)**2)*fes
