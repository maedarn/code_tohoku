       7081     3               !------------------------- neb (Kim+32)
       7082     3        v      fneb = 6.92d-1*((dlog(Tn/1.d1))**0) - 5.86d-1*((dlog(Tn/1.d1))**1) + &
       7083     3               8.16d-1*((dlog(Tn/1.d1))**2) - 5.05d-1*(dlog((Tn/1.d1))**3) &
       7084     3               + 1.18d-1*((dlog(Tn/1.d1))**4) + 7.66d-3*((dlog(Tn/1.d1))**5) - 5.08d-3*((dlog(Tn/1.d1))**6)
       7085     3        v      Lneb = (ndfgr(i,j,k)/ndtot(i,j,k)) * ndp(i,j,k) * nde(i,j,k) * (3.68d-23 * dexp(-3.86d1/Tn) * fneb) &
       7086     3               / ( (Tn/1.d1)**(0.5d0) * (1.d0+0.12d0*(nde(i,j,k)/100.d0)**(0.38d0-0.12d0*dlog(Tn/1.d1)))) * 1.9733d27
       7087     3               
