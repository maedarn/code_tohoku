       1876     4        v      do i = 0, Ncell
       1877     4               
       1878     4                 !ix  = iwx*i    + iwy*Lnum + iwz*Mnum
       1879     4                 !jy  = iwx*Mnum + iwy*i    + iwz*Lnum
       1880     4                 !kz  = iwx*Lnum + iwy*Mnum + iwz*i
       1881     4                 !ixp = iwx*(i+1)+ iwy*Lnum + iwz*Mnum
       1882     4                 !jyp = iwx*Mnum + iwy*(i+1)+ iwz*Lnum
       1883     4                 !kzp = iwx*Lnum + iwy*Mnum + iwz*(i+1)
       1884     4               
       1885     4        v        gamma =   3.d0*(ndH(i,mnum,lnum)+ndp(i,mnum,lnum)+ndHe(i,mnum,lnum)+ndHep(i,mnum,lnum))+5.d0*ndH2(i,mnum,lnum)
       1886     4        v        gamma = ( 5.d0*(ndH(i,mnum,lnum)+ndp(i,mnum,lnum)+ndHe(i,mnum,lnum)+ndHep(i,mnum,lnum))+7.d0*ndH2(i,mnum,lnum) )/gamma
       1887     4        v        cm = dsqrt(  (gamma * U(i,mnum,lnum,5) + Bcc(i,mnum,lnum,BT1)**2 + Bcc(i,mnum,lnum,BT2)**2) / U(i,mnum,lnum,1 )  )
       1888     4        v        depend1 = 0.5d0*(dxelr(i  ) - cm * dt)*facdep
       1889     4        v        depend1 = dmax1(0.d0, depend1)
       1890     4        v        gamma =   3.d0*(ndH(i+1,mnum,lnum)+ndp(i+1,mnum,lnum)+ndHe(i+1,mnum,lnum)+ndHep(i+1,mnum,lnum))+5.d0*ndH2(i+1,mnum,lnum)
       1891     4        v        gamma = ( 5.d0*(ndH(i+1,mnum,lnum)+ndp(i+1,mnum,lnum)+ndHe(i+1,mnum,lnum)+ndHep(i+1,mnum,lnum))+7.d0*ndH2(i+1,mnum,lnum) )/gamma
       1892     4        v        cm = dsqrt(  (gamma * U(i+1,mnum,lnum,5) + Bcc(i+1,mnum,lnum,BT1)**2 + Bcc(i+1,mnum,lnum,BT2)**2) / U(i+1,mnum,lnum,1)  )
       1893     4        v        depend2 = 0.5d0*(dxelr(i+1) - cm * dt)*facdep
       1894     4        v        depend2 = dmax1(0.d0, depend2)
       1895     4               
       1896     4        v        QL1 = U(i,mnum,lnum,1 ) + depend1 * grdQ(i,Mnum,Lnum,1 )
       1897     4        v        QL1 = (0.5d0-dsign(0.5d0,-QL1))*QL1 + (0.5d0+dsign(0.5d0,-QL1))*U(i,mnum,lnum,1)
       1898     4        v        QR1 = U(i+1,mnum,lnum,1 ) - depend2 * grdQ(i+1,Mnum,Lnum,1 )
       1899     4        v        QR1 = (0.5d0-dsign(0.5d0,-QR1))*QR1 + (0.5d0+dsign(0.5d0,-QR1))*U(i+1,mnum,lnum,1)
       1900     4        v        QL2 = U(i,mnum,lnum,VN) + depend1 * grdQ(i,Mnum,Lnum,VN)
       1901     4        v        QR2 = U(i+1,mnum,lnum,VN) - depend2 * grdQ(i+1,Mnum,Lnum,VN)
       1902     4        v        QL3 = U(i,mnum,lnum,5 ) + depend1 * grdQ(i,Mnum,Lnum,5 )
       1903     4        v        QL3 = (0.5d0-dsign(0.5d0,-QL3))*QL3 + (0.5d0+dsign(0.5d0,-QL3))*U(i,mnum,lnum,5)
       1904     4        v        QR3 = U(i+1,mnum,lnum,5 ) - depend2 * grdQ(i+1,Mnum,Lnum,5 )
       1905     4        v        QR3 = (0.5d0-dsign(0.5d0,-QR3))*QR3 + (0.5d0+dsign(0.5d0,-QR3))*U(i+1,mnum,lnum,5)
       1906     4        v        QL4 = (Bcc(i,mnum,lnum,BT1)+depend1*grdQ(i,Mnum,Lnum,BT1+8))**2 + (Bcc(i,mnum,lnum,BT2)+depend1*grdQ(i,Mnum,Lnum,BT2+8))**2
       1907     4        v        QR4 = (Bcc(i+1,mnum,lnum,BT1)-depend2*grdQ(i+1,Mnum,Lnum,BT1+8))**2 + (Bcc(i+1,mnum,lnum,BT2)-depend2*grdQ(i+1,Mnum,Lnum,BT2+8))**2
       1908     4               
       1909     4        v        ndHym =0.5d0*( ndH(i,mnum,lnum)+ ndH(i+1,mnum,lnum)); ndpm =0.5d0*(  ndp(i,mnum,lnum)+  ndp(i+1,mnum,lnum))
       1910     4        v        ndHem=0.5d0*(ndHe(i,mnum,lnum)+ndHe(i+1,mnum,lnum));ndHepm=0.5d0*(ndHep(i,mnum,lnum)+ndHep(i+1,mnum,lnum))
