       5863     4        v      LCIE = Sigmo * (LCIE)
       5864     4        v      Lneb = Lneb * (1.d0-Sigmo)
       5865     4        v      Lamdg = Lamdg * (1.d0-Sigmo)
       5866     4               
       5867     4        v      CooL  = (Lamc + Lamo + Lamd + LCOr + LCOH + LCOH2) + (LCIEHe + LCIE) &
       5868     4               - Gampe - Gamcr - Gampd + LamH2 + Laml + Lrr + Lff + Lneb - Gampm - GamH2f + Lamdg
