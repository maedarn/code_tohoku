                              <<< Loop-information  End >>>
       6352     4        m      do k = 1, Ncellz; do j = 1, Ncelly; do i = 1, Ncellx
       6353     4               
       6354     4               
       6355     4        v        ndpold=ndp(i,j,k); ndHold=ndH(i,j,k); ndH2old=ndH2(i,j,k); ndHmold=ndHm(i,j,k); ndHeold=ndHe(i,j,k)
       6356     4        v        ndHepold=ndHep(i,j,k); ndCold=ndC(i,j,k); ndCpold=ndCp(i,j,k); ndCOold=ndCO(i,j,k)
       6357     4        v        T = U(i,j,k,5)/kb/( ndpold+ndHold+ndH2old+ndHeold+ndHepold )
       6358     4               
       6359     4                 !--rate--
       6360     4        v          Av1  = 1.63542d-3*Nfgr(i,j,k,1); x1 = 6.1714d3*NH2(i,j,k,1)
       6361     4        v          Av2  = 1.63542d-3*Nfgr(i,j,k,2); x2 = 6.1714d3*NH2(i,j,k,2)
       6362     4        v          ATN2 = ( dexp(-3.77358d0*Av1) +dexp(-3.77358d0*Av2) )*0.5d0
       6363     4        v          ATN3 = ( dexp(-2.3585d0*Av1)  +dexp(-2.3585d0*Av2) )*0.5d0
       6364     4               
       6365     4                   !( 1 pc * 5.e-22  = 1.54285d-3 )
       6366     4                   !( 1 pc / 9.98337d16 = 3.09084d1 )
       6367     4        v          ATN4 = dmin1(1.d0, (3.0857d1*NH2(i,j,k,1))**(-3.d-2)*dexp(-1.54285d-3*NH2(i,j,k,1)) ) &
       6368     4                         +dmin1(1.d0, (3.0857d1*NH2(i,j,k,2))**(-3.d-2)*dexp(-1.54285d-3*NH2(i,j,k,2)) )
       6369     4        v          ATN4 = ATN4*0.5d0
       6370     4               
       6371     4                   !( 1 pc / 3.e15   = 1.02857d3 )
       6372     4                   !( 1 pc / 8.2189020e14 = 3.75439d3 )
       6373     4                   !( 1 pc / 4.2e16  = 7.3469d1 )
       6374     4                   !( 4.35068d15 / 1 pc = 1.40995d-3 )
       6375     4                   !( 8.97293d18 / 1 pc = 2.90791d0  )
       6376     4        v          ATN5 = &
       6377     4                    (0.5d0-dsign(0.5d0,NCO(i,j,k,1)-1.40995d-3))*dexp(-1.d0*(1.02857d3*NCO(i,j,k,1))**0.6) &
       6378     4                   +(0.5d0+dsign(0.5d0,NCO(i,j,k,1)-1.40995d-3))*dmin1( (3.75439d3*NCO(i,j,k,1)+1.d-100)**(-0.75d0),(7.3469d1*NCO(i,j,k,1)+1.d-100)**(-1.3d0) )
       6379     4        v          ATN5 = ATN5 + &
       6380     4                    (0.5d0-dsign(0.5d0,NCO(i,j,k,2)-1.40995d-3))*dexp(-1.d0*(1.02857d3*NCO(i,j,k,2))**0.6) &
       6381     4                   +(0.5d0+dsign(0.5d0,NCO(i,j,k,2)-1.40995d-3))*dmin1( (3.75439d3*NCO(i,j,k,2)+1.d-100)**(-0.75d0),(7.3469d1*NCO(i,j,k,2)+1.d-100)**(-1.3d0) )
       6382     4        v          ATN5 = ATN5*0.5d0
       6383     4               
       6384     4                   !H Ionization
       6385     4        v          zeta  = 9.4671d-4*zeta_cr
       6386     4                   !H Recombination
       6387     4        v          kHrec = (0.5d0+dsign(0.5d0,15.78d0-T))*0.45d0*dlog(1.578d2/T) &
       6388     4                          +(0.5d0-dsign(0.5d0,15.78d0-T))*0.4d0*dsqrt(1.578d2/T)
       6389     4        v          kHrec = 2.05572d1*(T**(-0.5d0))*kHrec
       6390     4                   !He Recombination
       6391     4        v          kHerec= 6.37623d1*(T**(-0.672d0))
       6392     4                   !H2 formation
       6393     4                   !kH2   = fgr*3.4569d-3*dsqrt(T)/(1.d0+1.26491d0*dsqrt(T+Tgr)+2.d0*T+8.d0*T**2)
       6394     4        v          kH2   = (ndfgr(i,j,k)/ndtot(i,j,k))*3.4569d-3*dsqrt(T)/(1.d0+1.26491d0*dsqrt(T+Tgr)+2.d0*T+8.d0*T**2)
       6395     4                   !***H2 Photo-dissociation
       6396     4        v          SHLD1 = 0.965d0/(1.d0+x1/dv)**2 + 0.035d0/dsqrt(1.d0+x1)*dexp(-8.5d-4*dsqrt(1.d0+x1))
       6397     4        v          SHLD2 = 0.965d0/(1.d0+x2/dv)**2 + 0.035d0/dsqrt(1.d0+x2)*dexp(-8.5d-4*dsqrt(1.d0+x2))
       6398     4        v          kH2ph = 1.04138d3 * G0*ATN2 * ( SHLD1+SHLD2 )*0.5d0
       6399     4                   !H2 destruction by H collision
       6400     4        v          kH2dH = 1.07294d5*dexp(-4.39d1/T)
       6401     4                   !H2 destruction by e collision
       6402     4        v          kH2de = 1.133d6*(T**0.35d0)*dexp(-1.02d2/T)
       6403     4                   !***CO formation
       6404     4                   !kCO   = 1.57785d-2/(1.d0+G0*ATN3/(ndH2(i,j,k)*xo))
       6405     4        v          kCO   = 1.57785d-2/(1.d0+G0*ATN3/(ndH2(i,j,k)*ndO(i,j,k)/ndtot(i,j,k)))
       6406     4                   !kCO   = 1.57785d-2/(1.d0+G0*ATN3/(ndH2(i,j,k)*ndO(i,j,k)/U(i,j,k,1))
       6407     4                   !***CO Photo-dissociation
       6408     4        v          kCOph = 3.155d3*G0*ATN3*ATN4*ATN5
       6409     4                   !***C ionization
       6410     4        v          SHLC1 = dexp(-2.6d0*Av1-3.0857d1*NnC(i,j,k,1)-4.33743413d-4*NH2(i,j,k,1))/(1.d0+4.33743413d-4*NH2(i,j,k,1))
       6411     4        v          SHLC2 = dexp(-2.6d0*Av2-3.0857d1*NnC(i,j,k,2)-4.33743413d-4*NH2(i,j,k,2))/(1.d0+4.33743413d-4*NH2(i,j,k,2))
       6412     4        v          kCi   = 3.97d0*zeta + 6.62697d3*G0 * ( SHLC1+SHLC2 )*0.5d0
       6413     4                   !C recombination
       6414     4        v          kCrec = 2.69267d1*(T**(-0.62d0))*(1.d0+1.d-4*dsqrt(nde(i,j,k))/(T**2))
       6415     4                   !CO destruction by e collision
       6416     4        v          kCOde = 1.4d4*(T**(-0.5d0))*dexp(-1.14d2/T)
       6417     4                   !CO destruction by H collision
       6418     4        v          kCOdH = 1.91858d3*(T**(-0.5d0))*dexp(-7.77d1/T)
       6419     4               
       6420     4                   !H  ionization by e collision
       6421     4        v          kHie  = 5.76d4*dsqrt(T)*dexp(-1.58d2/T)
       6422     4                   !He ionization by e collision
       6423     4        v          kHeie = 2.76d4*(T**0.43d0)*dexp(-2.85d2/T)
       6424     4                   !C  ionization by e collision
       6425     4        v          kCie  = 1.74d5*(T**0.4d0)*dexp(-1.31d2/T)
       6426     4               
       6427     4                   !H  ionization by H collision
       6428     4        v          kHiH  = 9.79d0*dsqrt(T)*dexp(-1.58d2/T)
       6429     4                   !He ionization by H or p or H2 collision
       6430     4        v          kHeiH = 4.57d0*(T**0.43d0)*dexp(-2.85d2/T)
       6431     4                   !C  ionization by H or p or H2 collision
       6432     4        v          kCiH  = 3.01d1*(T**0.4d0)*dexp(-1.31d2/T)
       6433     4                   !H2 destruction by Hep recombination
       6434     4        v          kH2dHep = 1.1676d0*dexp(-0.035d0/T)
       6435     4                   !CO destruction by Hep recombination
       6436     4        v          kCOdHep = 5.0491d4
       6437     4               
       6438     4                   !H- formation
       6439     4        v          dbleif_l = 0.5d0-dsign(0.5d0,T-6.d0)
       6440     4        v          kHm = -17.845d0+0.762d0*log10(T*1.d3)+0.1523d0*(log10(T*1.d3))**2-0.03274d0*(log10(T*1.d3))**3 * dbleif_l &
       6441     4                    -16.4199d0+0.1998d0*(log10(T*1.d3))**2-5.447d-3*(log10(T*1.d3))**4+4.0415d-5*(log10(T*1.d3))**6 * (1.d0-dbleif_l)
       6442     4        v          kHm = 3.1557d13*(10.d0**kHm)
       6443     4                   !H2 formation by Hm
       6444     4        v          kH2m = 3.1557d13*1.3d-9
       6445     4                   !Hm destruction
       6446     4        v          kHmde = 3.1557d13*2.4d-7*(dexp(-0.5d0*Av1)+dexp(-0.5d0*Av2))*0.5d0*(G0*0.5848d0)
       6447     4                 !--rate--
       6448     4               
       6449     4               
       6450     4               
       6451     4               
       6452     4                 !N_MPI(10) = 10; CALL BC_MPI_OT(2,1); N_MPI(10) = 0 !tst_chm
       6453     4               
       6454     4               !! H recombination & ionization by CR
       6455     4        v        temp1 = kHrec*nde(i,j,k)
       6456     4        v        temp2 = dexp(-dt*(zeta+temp1))
       6457     4        v        temp3 = 1.d0/(zeta+temp1)
       6458     4        v        eps=dt*(zeta+temp1)
       6459     4        v        omeps = ( 0.5d0+dsign(0.5d0,eps-1.d-4) )*( 1.d0-dexp(-eps) ) + &
       6460     4                 ( 0.5d0-dsign(0.5d0,eps-1.d-4) )*( eps-0.5d0*eps**2+0.16666666666666667d0*eps**3-4.16666666666666667d-2*eps**4 )
       6461     4        v        ndH(i,j,k) = ( temp1*ndHold + zeta*ndHold*temp2 + temp1*ndpold*omeps )*temp3
       6462     4        v        ndp(i,j,k) = (  zeta*ndpold +temp1*ndpold*temp2 +  zeta*ndHold*omeps )*temp3
       6463     4        v        ndHold = ndH(i,j,k); ndpold = ndp(i,j,k); nde(i,j,k) = ndp(i,j,k)+ndHep(i,j,k)+ndCp(i,j,k)
       6464     4               
       6465     4               !! He recombination & ionization by CR
       6466     4        v        temp1 = kHerec*nde(i,j,k)
       6467     4        v        temp2 = dexp(-dt*(zeta+temp1))
       6468     4        v        temp3 = 1.d0/(zeta+temp1)
       6469     4        v        eps=dt*(zeta+temp1)
       6470     4        v        omeps = ( 0.5d0+dsign(0.5d0,eps-1.d-4) )*( 1.d0-dexp(-eps) ) + &
       6471     4                 ( 0.5d0-dsign(0.5d0,eps-1.d-4) )*( eps-0.5d0*eps**2+0.16666666666666667d0*eps**3-4.16666666666666667d-2*eps**4 )
       6472     4        v        ndHe(i,j,k)  = ( temp1*ndHeold + zeta*ndHeold*temp2 + temp1*ndHepold*omeps )*temp3
       6473     4        v        ndHep(i,j,k) = ( zeta*ndHepold +temp1*ndHepold*temp2+  zeta*ndHeold*omeps )*temp3
       6474     4        v        ndHeold = ndHe(i,j,k); ndHepold = ndHep(i,j,k); nde(i,j,k) = ndp(i,j,k)+ndHep(i,j,k)+ndCp(i,j,k)
       6475     4               
       6476     4               !! H2 formation & dissociation by UV & electron collision
       6477     4        v        temp1 = kH2ph + kH2de*nde(i,j,k)
       6478     4        v        temp2 = temp1 + 2.d0*kH2*ndtot(i,j,k)
       6479     4        v        temp3 = dexp(-dt*temp2)
       6480     4        v        eps=dt*temp2
       6481     4        v        omeps = ( 0.5d0+dsign(0.5d0,eps-1.d-4) )*( 1.d0-dexp(-eps) ) + &
       6482     4                 ( 0.5d0-dsign(0.5d0,eps-1.d-4) )*( eps-0.5d0*eps**2+0.16666666666666667d0*eps**3-4.16666666666666667d-2*eps**4 )
       6483     4        v        ndH(i,j,k) = ( ndHold+2.d0*ndH2old*omeps )*temp1 + 2.d0*kH2*ndHold*ndtot(i,j,k)*temp3
       6484     4        v        ndH(i,j,k) = ndH(i,j,k)/temp2
       6485     4        v        ndH2(i,j,k)= ( 2.d0*ndH2old+ndHold*omeps )*kH2*ndtot(i,j,k) + temp1*ndH2old*temp3
       6486     4        v        ndH2(i,j,k)= ndH2(i,j,k)/temp2
       6487     4        v        ndHold = ndH(i,j,k); ndH2old = ndH2(i,j,k)
       6488     4               
       6489     4               !! H2 dissociation by H collision
       6490     4        v        temp1 = ndHold + 2.d0*ndH2old
       6491     4        v        temp2 = dexp(-dt*temp1*kH2dH)
       6492     4        v        temp3 = 1.d0/(ndHold + 2.d0*ndH2old*temp2)
       6493     4        v        ndH(i,j,k) = ndHold*temp1*temp3
       6494     4        v        ndH2(i,j,k)= ndH2old*temp1*temp2*temp3
       6495     4        v        ndHold = ndH(i,j,k); ndH2old = ndH2(i,j,k)
       6496     4               
       6497     4               !! CO formation
       6498     4        v        temp1 = dexp(-dt*kCO*ndtot(i,j,k))
       6499     4        v        eps = dt*kCO*ndtot(i,j,k)
       6500     4        v        omeps = ( 0.5d0+dsign(0.5d0,eps-1.d-4) )*( 1.d0-dexp(-eps) ) + &
       6501     4                 ( 0.5d0-dsign(0.5d0,eps-1.d-4) )*( eps-0.5d0*eps**2+0.16666666666666667d0*eps**3-4.16666666666666667d-2*eps**4 )
       6502     4        v        ndCO(i,j,k)  = ndCOold + omeps*ndCpold
       6503     4        v        ndCp(i,j,k)  = temp1*ndCpold
       6504     4        v        ndCOold = ndCO(i,j,k); ndCpold = ndCp(i,j,k); nde(i,j,k) = ndp(i,j,k)+ndHep(i,j,k)+ndCp(i,j,k)
       6505     4               
       6506     4               
       6507     4               !! CO dissociation by UV & electron collision & H collision
       6508     4        v        temp1 = dexp(-dt*(kCOph+kCOde*nde(i,j,k)+kCOdH*ndHold))
       6509     4        v        eps = dt*(kCOph+kCOde*nde(i,j,k)+kCOdH*ndHold)
       6510     4        v        omeps = ( 0.5d0+dsign(0.5d0,eps-1.d-4) )*( 1.d0-dexp(-eps) ) + &
       6511     4                 ( 0.5d0-dsign(0.5d0,eps-1.d-4) )*( eps-0.5d0*eps**2+0.16666666666666667d0*eps**3-4.16666666666666667d-2*eps**4 )
       6512     4        v        ndC(i,j,k) = ndCold + omeps*ndCOold
       6513     4        v        ndCO(i,j,k)= temp1*ndCOold
       6514     4        v        ndCold = ndC(i,j,k); ndCOold = ndCO(i,j,k)
       6515     4               
       6516     4               !! C recombination & ionization by CR & UV
       6517     4        v        temp1 = kCrec*nde(i,j,k)
       6518     4        v        temp2 = dexp(-dt*(kCi+temp1))
       6519     4        v        temp3 = 1.d0/(kCi+temp1)
       6520     4        v        eps=dt*(kCi+temp1)
       6521     4        v        omeps = ( 0.5d0+dsign(0.5d0,eps-1.d-4) )*( 1.d0-dexp(-eps) ) + &
       6522     4                 ( 0.5d0-dsign(0.5d0,eps-1.d-4) )*( eps-0.5d0*eps**2+0.16666666666666667d0*eps**3-4.16666666666666667d-2*eps**4 )
       6523     4        v        ndC(i,j,k) = ( temp1*ndCold +   kCi*ndCold*temp2 + temp1*ndCpold*omeps )*temp3
       6524     4        v        ndCp(i,j,k)= (  kCi*ndCpold + temp1*ndCpold*temp2+   kCi*ndCold*omeps )*temp3
       6525     4        v        ndCold = ndC(i,j,k); ndCpold = ndCp(i,j,k); nde(i,j,k) = ndp(i,j,k)+ndHep(i,j,k)+ndCp(i,j,k)
       6526     4               
       6527     4               !! H, He, C ionization by e collision
       6528     4        v         ndH(i,j,k) = ndHold *dexp(-dt*kHie *nde(i,j,k))
       6529     4        v        ndHe(i,j,k) = ndHeold*dexp(-dt*kHeie*nde(i,j,k))
       6530     4        v         ndC(i,j,k) = ndCold *dexp(-dt*kCie *nde(i,j,k))
       6531     4        v        eps=dt*kHie *nde(i,j,k)
       6532     4        v        omeps = ( 0.5d0+dsign(0.5d0,eps-1.d-4) )*( 1.d0-dexp(-eps) ) + &
       6533     4                 ( 0.5d0-dsign(0.5d0,eps-1.d-4) )*( eps-0.5d0*eps**2+0.16666666666666667d0*eps**3-4.16666666666666667d-2*eps**4 )
       6534     4        v        ndp(i,j,k) = omeps*ndHold + ndpold
       6535     4        v        eps=dt*kHeie*nde(i,j,k)
       6536     4        v        omeps = ( 0.5d0+dsign(0.5d0,eps-1.d-4) )*( 1.d0-dexp(-eps) ) + &
       6537     4                 ( 0.5d0-dsign(0.5d0,eps-1.d-4) )*( eps-0.5d0*eps**2+0.16666666666666667d0*eps**3-4.16666666666666667d-2*eps**4 )
       6538     4        v        ndHep(i,j,k)= omeps*ndHeold+ ndHepold
       6539     4        v        eps=dt*kCie *nde(i,j,k)
       6540     4        v        omeps = ( 0.5d0+dsign(0.5d0,eps-1.d-4) )*( 1.d0-dexp(-eps) ) + &
       6541     4                 ( 0.5d0-dsign(0.5d0,eps-1.d-4) )*( eps-0.5d0*eps**2+0.16666666666666667d0*eps**3-4.16666666666666667d-2*eps**4 )
       6542     4        v        ndCp(i,j,k) = omeps*ndCold + ndCpold
       6543     4        v        ndHold = ndH(i,j,k); ndHeold  =  ndHe(i,j,k);  ndCold =  ndC(i,j,k)
       6544     4        v        ndpold = ndp(i,j,k); ndHepold = ndHep(i,j,k); ndCpold = ndCp(i,j,k)
       6545     4        v        nde(i,j,k) = ndp(i,j,k)+ndHep(i,j,k)+ndCp(i,j,k)
       6546     4               
       6547     4               
       6548     4               !! H, He, C ionization by H or H2 or p collision
       6549     4        v         temp1 = 1.d0/( 1.d0+kHiH*dt*ndHold )
       6550     4        v         ndH(i,j,k) = ndHold*temp1
       6551     4        v         ndp(i,j,k) = ndpold+temp1*kHiH*dt*ndHold**2
       6552     4        v         temp1 = ndH(i,j,k)+ndp(i,j,k)+ndH2old
       6553     4        v        ndHe(i,j,k) = ndHeold*dexp(-dt*kHeiH*temp1)
       6554     4        v         ndC(i,j,k) = ndCold *dexp(-dt*kCiH *temp1)
       6555     4        v        eps=dt*kHeiH*temp1
       6556     4        v        omeps = ( 0.5d0+dsign(0.5d0,eps-1.d-4) )*( 1.d0-dexp(-eps) ) + &
       6557     4                 ( 0.5d0-dsign(0.5d0,eps-1.d-4) )*( eps-0.5d0*eps**2+0.16666666666666667d0*eps**3-4.16666666666666667d-2*eps**4 )
       6558     4        v        ndHep(i,j,k)= omeps*ndHeold+ ndHepold
       6559     4        v        eps=dt*kCiH *temp1
       6560     4        v        omeps = ( 0.5d0+dsign(0.5d0,eps-1.d-4) )*( 1.d0-dexp(-eps) ) + &
       6561     4                 ( 0.5d0-dsign(0.5d0,eps-1.d-4) )*( eps-0.5d0*eps**2+0.16666666666666667d0*eps**3-4.16666666666666667d-2*eps**4 )
       6562     4        v        ndCp(i,j,k) = omeps*ndCold + ndCpold
       6563     4        v        ndHold = ndH(i,j,k); ndHeold  =  ndHe(i,j,k);  ndCold =  ndC(i,j,k)
       6564     4        v        ndpold = ndp(i,j,k); ndHepold = ndHep(i,j,k); ndCpold = ndCp(i,j,k)
       6565     4        v        nde(i,j,k) = ndp(i,j,k)+ndHep(i,j,k)+ndCp(i,j,k)
       6566     4               
       6567     4               
       6568     4               !! H2 dissiciation by Hep recombination
       6569     4        v        temp1 = ndHepold-ndH2old
       6570     4        v        dbleif_l = 0.5d0-dsign(0.5d0,temp1-1.d-50)
       6571     4        v        dbleif_g = 0.5d0+dsign(0.5d0,temp1-1.d-50)
       6572     4                 !if(temp1.gt.1.d-50) then
       6573     4        v          temp3 = dexp(-dt*kH2dHep*temp1)
       6574     4        v          temp2 = 1.d0/( ndHepold-ndH2old*temp3 )
       6575     4        v          ndHep(i,j,k) = ndHepold*temp1*temp2 * dbleif_g + ndHepold * (1.d0-dbleif_g)
       6576     4        v           ndH2(i,j,k) =  ndH2old*temp1*temp2*temp3 * dbleif_g + ndH2old * (1.d0-dbleif_g)
       6577     4        v          temp3 = ndHepold*( 1.d0-temp1*temp2 )
       6578     4        v            ndp(i,j,k) =  ndpold + temp3 * dbleif_g
       6579     4        v            ndH(i,j,k) =  ndHold + temp3 * dbleif_g
       6580     4        v           ndHe(i,j,k) = ndHeold + temp3 * dbleif_g
       6581     4                 !endif
       6582     4                 !if(temp1.lt.-1.d-50) then
       6583     4        v          temp3 = dexp(dt*kH2dHep*temp1)
       6584     4        v          temp2 = 1.d0/( ndHepold*temp3-ndH2old )
       6585     4        v          ndHep(i,j,k) = ndHepold*temp1*temp2*temp3 * dbleif_l + ndHepold * (1.d0-dbleif_l)
       6586     4        v           ndH2(i,j,k) =  ndH2old*temp1*temp2 * dbleif_l + ndH2old * (1.d0-dbleif_l)
       6587     4        v          temp3 = ndHepold*( 1.d0-temp1*temp2*temp3 )
       6588     4        v            ndp(i,j,k) =  ndpold + temp3 * dbleif_l
       6589     4        v            ndH(i,j,k) =  ndHold + temp3 * dbleif_l
       6590     4        v           ndHe(i,j,k) = ndHeold + temp3 * dbleif_l
       6591     4                 !end if
       6592     4        v         ndHold =  ndH(i,j,k);   ndpold =   ndp(i,j,k); ndH2old = ndH2(i,j,k)
       6593     4        v        ndHeold = ndHe(i,j,k); ndHepold = ndHep(i,j,k)
       6594     4        v        nde(i,j,k) = ndp(i,j,k)+ndHep(i,j,k)+ndCp(i,j,k)
       6595     4               
       6596     4               
       6597     4               !! CO dissiciation by Hep recombination
       6598     4        v        temp1 = ndHepold-ndCOold
       6599     4        v        dbleif_l = 0.5d0-dsign(0.5d0,temp1-1.d-50)
       6600     4        v        dbleif_g = 0.5d0+dsign(0.5d0,temp1-1.d-50)
       6601     4                 !if(temp1.gt.1.d-50) then
       6602     4        v          temp3 = dexp(-dt*kCOdHep*temp1)
       6603     4        v          temp2 = 1.d0/( ndHepold-ndCOold*temp3 )
       6604     4        v          ndHep(i,j,k) = ndHepold*temp1*temp2 * dbleif_g + ndHepold * (1.d0-dbleif_g)
       6605     4        v           ndCO(i,j,k) =  ndCOold*temp1*temp2*temp3 * dbleif_g + ndCOold * (1.d0-dbleif_g)
       6606     4        v          temp3 = ndHepold*( 1.d0-temp1*temp2 )
       6607     4        v           ndCp(i,j,k) = ndCpold + temp3 * dbleif_g
       6608     4        v           ndHe(i,j,k) = ndHeold + temp3 * dbleif_g
       6609     4                 !endif
       6610     4                 !if(temp1.lt.-1.d-50) then
       6611     4        v          temp3 = dexp(dt*kCOdHep*temp1)
       6612     4        v          temp2 = 1.d0/( ndHepold*temp3-ndCOold )
