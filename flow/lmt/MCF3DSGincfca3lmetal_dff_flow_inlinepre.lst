       5850     4               / ( (Tn(i,j,k)/1.d1)**(0.5d0) * (1.d0+0.12d0*(nde(i,j,k)/100.d0)**(0.38d0-0.12d0*dlog(Tn(i,j,k)/1.d1)))) * 1.9733d27
