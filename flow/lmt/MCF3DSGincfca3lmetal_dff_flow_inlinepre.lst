       6293     4                 !------------------------- neb (Kim+32)
       6294     4        v        fneb = 6.92d-1*((dlog(Tn(i,j,k)/1.d1))**0) - 5.86d-1*((dlog(Tn(i,j,k)/1.d1))**1) + &
       6295     4                 8.16d-1*((dlog(Tn(i,j,k)/1.d1))**2) - 5.05d-1*(dlog((Tn(i,j,k)/1.d1))**3) &
       6296     4                 + 1.18d-1*((dlog(Tn(i,j,k)/1.d1))**4) + 7.66d-3*((dlog(Tn(i,j,k)/1.d1))**5) - 5.08d-3*((dlog(Tn(i,j,k)/1.d1))**6)
       6297     4                 !Lneb = Zsolar * ndp(i,j,k) * nde(i,j,k) * (3.68d-23 * dexp(-3.86d1/Tn(i,j,k)) * fneb) &
       6298     4                 !/ ( (Tn(i,j,k)/1.d1)**(0.5d0) * (1.d0+0.12d0*(nde(i,j,k)/100.d0)**(0.38d0-0.12d0*dlog(Tn(i,j,k)/1.d1)))) * 1.9733d27
       6299     4        v        Lneb = (ndfgr(i,j,k)/ndtot(i,j,k)) * ndp(i,j,k) * nde(i,j,k) * (3.68d-23 * dexp(-3.86d1/Tn(i,j,k)) * fneb) &
       6300     4                 / ( (Tn(i,j,k)/1.d1)**(0.5d0) * (1.d0+0.12d0*(nde(i,j,k)/100.d0)**(0.38d0-0.12d0*dlog(Tn(i,j,k)/1.d1)))) * 1.9733d27
       6301     4                 !cmtime_CPU(10) = MPI_WTIME()
       6302     4               
       6303     4                 !----Kim+23
       6304     4        v        Sigmo=1.d0/(1.d0+dexp(-asigmo*(Tn(i,j,k)-0.5d0*(Tth1+Tth2))/(Tth2-Tth1)))
       6305     4               
       6306     4        v        Lamc = Lamc * (1.d0-Sigmo)
       6307     4        v        Lamo = Lamo * (1.d0-Sigmo)
       6308     4        v        Lamd = Lamd * (1.d0-Sigmo)
       6309     4        v        LCOr = LCOr * (1.d0-Sigmo)
       6310     4        v        LCOH = LCOH * (1.d0-Sigmo)
       6311     4        v        LCOH2 = LCOH2 * (1.d0-Sigmo)
       6312     4        v        LCIEHe = Sigmo * (LCIEHe)
       6313     4        v        LCIE = Sigmo * (LCIE)
       6314     4        v        Lneb = Lneb * (1.d0-Sigmo)
       6315     4        v        Lamdg = Lamdg * (1.d0-Sigmo)
       6316     4               
       6317     4        v        CooL  = (Lamc + Lamo + Lamd + LCOr + LCOH + LCOH2) + (LCIEHe + LCIE) &
       6318     4                 - Gampe - Gamcr - Gampd + LamH2 + Laml + Lrr + Lff + Lneb - Gampm - GamH2f + Lamdg
       6319     4               !----Fcool---
       6320     4               
       6321     4        v        gammi1 =   3.d0*(ndH(i,j,k)+ndp(i,j,k)+ndHe(i,j,k)+ndHep(i,j,k))+5.d0*ndH2(i,j,k)
       6322     4        v        gammi1 = ( 2.d0*(ndH(i,j,k)+ndp(i,j,k)+ndHe(i,j,k)+ndHep(i,j,k))+2.d0*ndH2(i,j,k) )/gammi1
       6323     4               
       6324     4        v        U(i,j,k,5) = Pn(i,j,k) - gammi1*CooL*dt !explicit
       6325     4                 !enddo;enddo;enddo
       6326     4               
       6327     4                 !do k = 1, Ncellz; do j = 1, Ncelly; do i = 1, Ncellx
       6328     4                 !----- Conduction ------------------------------------------------------
       6329     4        v        tcd = gammi1*Kcond*dsqrt( Tn(i,j,k) )
       6330     4        v        tcd = 0.49d0*(ndH(i,j,k)+ndp(i,j,k)+ndHe(i,j,k)+ndHep(i,j,k)+ndH2(i,j,k))*kb/tcd*(dx(i)**2.d0)
       6331     4        v        tcd = dsign(0.5d0,tcd-dt)
       6332     4        v        U(i,j,k,5) = U(i,j,k,5) + (tcd+0.5d0)*gammi1*dt* &
       6333     4                 ( (Qx(i,j,k)-Qx(i-1,j,k))/dx(i) + (Qy(i,j,k)-Qy(i,j-1,k))/dy(j) + (Qz(i,j,k)-Qz(i,j,k-1))/dz(k) )
       6334     4        v        U(i,j,k,5) = dmax1(U(i,j,k,5),pmin)
       6335     4        v        U(i,j,k,5) = dmin1(U(i,j,k,5),pmax)
       6336     4        v        U(i,j,k,5) = dmax1(U(i,j,k,5),TCMB*kb*(ndp(i,j,k)+ndH(i,j,k)+ndH2(i,j,k)+ndHe(i,j,k)+ndHep(i,j,k)))
       6337     4        m      end do; end do; end do
