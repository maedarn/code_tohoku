       1947     4        v            qM1sqi = pp1i+dsqrt( pp1i*pp1i-8.d0*(Pai-P1i)*(GAMpl1*Pai+GP1i) )
       1948     4        v            qM1i   = dsqrt( qM1sqi*D1i )*0.5d0
       1949     4        v            pp2i = GAMpl3*Pai + GP2B2i
       1950     4        v            qM2sqi = pp2i+dsqrt( pp2i*pp2i-8.d0*(Pai-P2i)*(GAMpl1*Pai+GP2i) )
       1951     4        v            qM2i   = dsqrt( qM2sqi*D2i )*0.5d0
