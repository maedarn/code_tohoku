        331                     SUBROUTINE BCsgr_MPI(u,nx,ny,nz,lx1,lx2,ly1,ly2,lz1,lz2)
        332                     USE mpivar
        333                     INCLUDE 'mpif.h'
        334                     DOUBLE PRECISION :: u(0:nx,0:ny,0:nz)
        335                     DOUBLE PRECISION  :: VECU
        336                     INTEGER :: MSTATUS(MPI_STATUS_SIZE)
        337                     INTEGER :: LEFTt,RIGTt
        338                     
        339                     CALL MPI_BARRIER(MPI_COMM_WORLD,IERR)
        340                     !*** for X ***!
        341                     LEFTt = LEFT; IF(IST.eq.0)        LEFTt = MPI_PROC_NULL
        342                     RIGTt = RIGT; IF(IST.eq.NSPLTx-1) RIGTt = MPI_PROC_NULL
        343                     CALL MPI_TYPE_VECTOR((ny+1)*(nz+1),1,nx+1,MPI_REAL8,VECU,IERR); CALL MPI_TYPE_COMMIT(VECU,IERR)
        344                     if(lx1.eq.1) CALL MPI_SENDRECV(u(nx-1,0,0),1,VECU,RIGTt,1, &
        345                                                    u(   0,0,0),1,VECU,LEFTt,1, MPI_COMM_WORLD,MSTATUS,IERR)
        346                     if(lx2.eq.1) CALL MPI_SENDRECV(u(   1,0,0),1,VECU,LEFTt,1, &
        347                                                    u(nx  ,0,0),1,VECU,RIGTt,1, MPI_COMM_WORLD,MSTATUS,IERR)
        348                     CALL MPI_TYPE_FREE(VECU,IERR)
        349                     !*** for Y ***!
        350                     !IF(JST.eq.0)        BOTM = MPI_PROC_NULL
        351                     !IF(JST.eq.NSPLTy-1) TOP  = MPI_PROC_NULL
        352                     CALL MPI_TYPE_VECTOR(nz+1,nx+1,(nx+1)*(ny+1),MPI_REAL8,VECU,IERR); CALL MPI_TYPE_COMMIT(VECU,IERR)
        353                     if(ly1.eq.1) CALL MPI_SENDRECV(u(0,ny-1,0),1,VECU,TOP ,1, &
        354                                                    u(0,   0,0),1,VECU,BOTM,1, MPI_COMM_WORLD,MSTATUS,IERR)
        355                     if(ly2.eq.1) CALL MPI_SENDRECV(u(0,   1,0),1,VECU,BOTM,1, &
        356                                                    u(0,ny  ,0),1,VECU,TOP ,1, MPI_COMM_WORLD,MSTATUS,IERR)
        357                     CALL MPI_TYPE_FREE(VECU,IERR)
        358                     !*** for z ***!
        359                     !IF(KST.eq.0)        DOWN = MPI_PROC_NULL
        360                     !IF(KST.eq.NSPLTz-1) UP   = MPI_PROC_NULL
        361                     CALL MPI_TYPE_VECTOR(1,(nx+1)*(ny+1),(nx+1)*(ny+1),MPI_REAL8,VECU,IERR); CALL MPI_TYPE_COMMIT(VECU,IERR)
        362                     if(lz1.eq.1) CALL MPI_SENDRECV(u(0,0,nz-1),1,VECU,UP  ,1, &
        363                                                    u(0,0,   0),1,VECU,DOWN,1, MPI_COMM_WORLD,MSTATUS,IERR)
        364                     if(lz2.eq.1) CALL MPI_SENDRECV(u(0,0,   1),1,VECU,DOWN,1, &
        365                                                    u(0,0,nz  ),1,VECU,UP  ,1, MPI_COMM_WORLD,MSTATUS,IERR)
        366                     CALL MPI_TYPE_FREE(VECU,IERR)
        367                     !CALL MPI_BARRIER(MPI_COMM_WORLD,IERR)
        368                     
        369                     END SUBROUTINE BCsgr_MPI

