        178                     
        179                     !***********************************
        180                     ! set BC in interp (except in addint) and the first slvsml when fixed boundary except phi=0
        181                     !
        182                     SUBROUTINE mglin(Need1,Need2,ncycle,NPRE,NPOST)
        183                     USE comvar
        184                     USE mpivar
        185                     USE slfgrv
        186                     INCLUDE 'mpif.h'
        187                     DOUBLE PRECISION :: cphi1(Need1),crho1(Need1),cres1(Need1),crhs1(Need1) !Unsplit
        188                     DOUBLE PRECISION :: cphi2(Need2),crho2(Need2),cres2(Need2),crhs2(Need2) !MPI Split
