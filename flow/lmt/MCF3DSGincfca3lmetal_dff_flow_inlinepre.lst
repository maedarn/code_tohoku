 External subroutine subprogram "RIEMAN"
  (line-no.)(nest)(optimize)
       2590                     
       2591                     
       2592                     !*======================================================================*
       2593                     !*                 The Riemann Solver for Adiabatic Gases               *
       2594                     !*                    with Tangential Magnetic Fields                   *
       2595                     !*======================================================================*
       2596                     SUBROUTINE RIEMAN( uLi1,uLi2,uLi3,uLi4,uRi1,uRi2,uRi3,uRi4,Pai,Vai, itrn )
       2597                     USE comvar
       2598                     integer :: itrn
       2599                     double precision  :: Pai,Vai,uLi1,uLi2,uLi3,uLi4,uRi1,uRi2,uRi3,uRi4
       2600                     double precision  :: D1i,D2i,V1i,V2i,P1i,P2i,B1i,B2i,GP1i,GP2i,GP1B1i,GP2B2i,pp1i,pp2i,qM1i,qM2i,qM1sqi,qM2sqi,PaOLDi
       2601                     
       2602                     
       2603                     !call fapp_start("loop3",1,0)
       2604                     
       2605                     D1i = uLi1
       2606                     V1i = uLi2
       2607                     P1i = uLi3
       2608                     B1i = 0.5d0 * uLi4
       2609                     D2i = uRi1
       2610                     V2i = uRi2
       2611                     P2i = uRi3
       2612                     B2i = 0.5d0 * uRi4
       2613                     
       2614                     !*****    B1 = 0.5 * B1^2     B2 = 0.5 * B2^2
       2615                     
       2616                     P1i    = P1i + B1i
       2617                     P2i    = P2i + B2i
       2618                     GP1i   = GAMmi1*P1i
       2619                     GP2i   = GAMmi1*P2i
       2620                     GP1B1i = GAMmi3*P1i - GAMmi2*B1i*2.d0
       2621                     GP2B2i = GAMmi3*P2i - GAMmi2*B2i*2.d0
       2622                     
       2623                     Pai  = ( P1i + P2i )*0.5d0
       2624                     
       2625     1        s      do loop = 1, itrn
       2626     1               
       2627     1        s        pp1i = GAMpl3*Pai + GP1B1i
       2628     1        s        qM1sqi = pp1i+dsqrt( pp1i*pp1i-8.d0*(Pai-P1i)*(GAMpl1*Pai+GP1i) )
       2629     1        s        qM1i   = dsqrt( qM1sqi*D1i )*0.5d0
       2630     1        s        pp2i = GAMpl3*Pai + GP2B2i
       2631     1        s        qM2sqi = pp2i+dsqrt( pp2i*pp2i-8.d0*(Pai-P2i)*(GAMpl1*Pai+GP2i) )
       2632     1        s        qM2i   = dsqrt( qM2sqi*D2i )*0.5d0
       2633     1        s        PaOLDi = Pai
       2634     1        s        Pai    = qM2i*P1i + qM1i*P2i + qM2i*qM1i*(V1i-V2i)
       2635     1        s        Pai    = Pai/( qM2i + qM1i )
       2636     1        s        if(Pai.le.0.0) Pai = 0.1d0*PaOLDi
       2637     1               
       2638     1        s        pp1i = GAMpl3*Pai + GP1B1i
       2639     1        s        qM1sqi = pp1i+dsqrt( pp1i*pp1i-8.d0*(Pai-P1i)*(GAMpl1*Pai+GP1i) )
       2640     1        s        qM1i   = dsqrt( qM1sqi*D1i )*0.5d0
       2641     1        s        pp2i = GAMpl3*Pai + GP2B2i
       2642     1        s        qM2sqi = pp2i+dsqrt( pp2i*pp2i-8.d0*(Pai-P2i)*(GAMpl1*Pai+GP2i) )
       2643     1        s        qM2i   = dsqrt( qM2sqi*D2i )*0.5d0
       2644     1        s        PaOLDi = Pai
