       5905     4        m      do k = 0, Ncellz; do j = 0, Ncelly; do i = 0, Ncellx
       5906     4        v        rtTx    = dsqrt(  ( dx(i)*Tn(i+1,j,k)+dx(i+1)*Tn(i,j,k) ) /( dx(i) + dx(i+1) )  )
       5907     4        v        rtTy    = dsqrt(  ( dy(j)*Tn(i,j+1,k)+dy(j+1)*Tn(i,j,k) ) /( dy(j) + dy(j+1) )  )
       5908     4        v        rtTz    = dsqrt(  ( dz(k)*Tn(i,j,k+1)+dz(k+1)*Tn(i,j,k) ) /( dz(k) + dz(k+1) )  )
       5909     4        v        Qx(i,j,k) = Kcond * dmin1(rtTx,3.873d0) * ( Tn(i+1,j,k)-Tn(i,j,k) )*2.d0 /( dx(i) + dx(i+1) )
       5910     4        v        Qy(i,j,k) = Kcond * dmin1(rtTy,3.873d0) * ( Tn(i,j+1,k)-Tn(i,j,k) )*2.d0 /( dy(j) + dy(j+1) )
       5911     4        v        Qz(i,j,k) = Kcond * dmin1(rtTz,3.873d0) * ( Tn(i,j,k+1)-Tn(i,j,k) )*2.d0 /( dz(k) + dz(k+1) )
       5912     4        m      end do; end do; end do
