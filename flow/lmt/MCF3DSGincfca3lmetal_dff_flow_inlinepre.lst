       3965                     !     Courant Condition for Euler code
       3966                     !=====================================================================*
       3967                     SUBROUTINE Couran(tCFL)
       3968                     USE comvar
       3969                     USE mpivar
       3970                     USE chmvar
       3971                     
       3972                     double precision :: tCFL,c2
       3973                     
       3974                     tCFL = tfinal
                              <<< Loop-information Start >>>
                              <<<  [OPTIMIZATION]
                              <<<    SIMD(VL: 8)
                              <<<    SOFTWARE PIPELINING(IPC: 2.13, ITR: 64, MVE: 3, POL: L)
                              <<<    PREFETCH(HARD) Expected by compiler :
                              <<<      ndp, ndHe, ndHep, ndH, ndH2, Bcc, U, dx
                              <<< Loop-information  End >>>
       3975     3        m      do k = 1, Ncellz; do j = 1, Ncelly; do i = 1, Ncellx
       3976     3        v        gamma =   3.d0*(ndH(i,j,k)+ndp(i,j,k)+ndHe(i,j,k)+ndHep(i,j,k))+5.d0*ndH2(i,j,k)
       3977     3        v        gamma = ( 5.d0*(ndH(i,j,k)+ndp(i,j,k)+ndHe(i,j,k)+ndHep(i,j,k))+7.d0*ndH2(i,j,k) )/gamma
       3978     3        v        c2 = ( gamma * U(i,j,k,5) + Bcc(i,j,k,1)**2.d0+Bcc(i,j,k,2)**2.d0+Bcc(i,j,k,3)**2.d0 ) / U(i,j,k,1)
       3979     3        v        tCFL = dmin1(tCFL, dx(i)/(dsqrt(c2) + dabs(U(i,j,k,2))) )
       3980     3        v        tCFL = dmin1(tCFL, dy(j)/(dsqrt(c2) + dabs(U(i,j,k,3))) )
       3981     3        v        tCFL = dmin1(tCFL, dz(k)/(dsqrt(c2) + dabs(U(i,j,k,4))) )
       3982     3        m      end do; end do; end do
       3983                     if(tCFL.lt.0.d0) write(*,*) time,NRANK,'err at Couran'
       3984                     
       3985                     END SUBROUTINE Couran

