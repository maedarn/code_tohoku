        736                     SUBROUTINE ran0(ran,idum)
        737                     INTEGER idum,IA,IM,IQ,IR,MASK
        738                     DOUBLE PRECISION ran,AM
        739                     PARAMETER (IA=16807,IM=2147483647,AM=1./IM,IQ=127773,IR=2836,MASK=123459876)
        740                     INTEGER k
        741                     !idum=ieor(idum,MASK)
        742                     k=idum/IQ
