       5526     4        v      phis=(ndtot(i,j,k)-nde(i,j,k)/1.2d0)*0.67d0/(ndtot(i,j,k)+nde(i,j,k)/5.d-2)
       5527     4        v      Gamcr = (ndH(i,j,k)+ndHe(i,j,k)+ndH2(i,j,k)+nde(i,j,k)) * Ecr * zeta_cr * 3.d-17 / (1.d0 + phis) * 1.9733d27
