       5872     4        v        gammi1 = ( 2.d0*(ndH(i,j,k)+ndp(i,j,k)+ndHe(i,j,k)+ndHep(i,j,k))+2.d0*ndH2(i,j,k) )/gammi1
       5873     4                ! if( dt .le. 0.2d0*Pn(i,j,k)/(gammi1*dabs(CooL)) ) then
       5874     4        v          U(i,j,k,5) = U(i,j,k,5) - gammi1*CooL*dt*0.5d0 !explicit
       5875     4                ! else
       5876     4                !   Call IMC( U(i,j,k,5),ndH(i,j,k)+ndp(i,j,k)+ndHe(i,j,k)+ndHep(i,j,k)+ndH2(i,j,k),dt*0.5d0,i,j,k ) !implicit
       5877     4                ! end if
