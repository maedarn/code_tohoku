       1912     4        v        gamma = ( 5.d0*(ndHym+ndpm+ndHem+ndHepm)+7.d0*ndH2m )/( 3.d0*(ndHym+ndpm+ndHem+ndHepm)+5.d0*ndH2m )
       1913     4        v        gammi1 = gamma - 1.0d0
