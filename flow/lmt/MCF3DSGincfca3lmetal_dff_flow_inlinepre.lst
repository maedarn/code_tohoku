        218     1                 ngrid=ngrid-1
        219     1                 call rstrct(crho1(point1(ngrid)),crho1(point1(ngrid+1)),ncx,ncy,ncz,0)
        220     1               end do
        221                     
        222                     call slvsmlb(cphi1(point1(1)),crho1(point1(1))) !BC set is necessary
        223                     
        224                     !Here nc=3
        225                     ngrid = NGL
        226     1               do j=2,ngrid
        227     1               
        228     2                 IF(j.le.NGcr) THEN !*** generate candidate sol. from j-1 to j (upward) ***
        229     2                   ncx=ncx*2-1; ncy=ncy*2-1; ncz=ncz*2-1
        230     2                   call interp(cphi1(point1(j)),cphi1(point1(j-1)),ncx,ncy,ncz,pointb1(j),1)  !BC set is necessary
        231     2                   call copy(crhs1(point1(j)),crho1(point1(j)),ncx,ncy,ncz)
        232     3                   if(j.eq.NGcr) then
        233     3                     ncx=ncxcr; ncy=ncycr; ncz=nczcr
        234     3                     call divide( cphi2(point2(NGcr)),cphi1(point1(NGcr)),ncx,ncy,ncz,2**NGcr+1,2**NGcr+1,2**NGcr+1 )
        235     3                     call copyMPI(crhs2(point2(NGcr)),crho2(point2(NGcr)),ncx,ncy,ncz)
        236     3                   end if
        237     2                 ELSE
