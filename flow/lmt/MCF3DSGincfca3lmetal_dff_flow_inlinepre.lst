 External subroutine subprogram "pinter"
  (line-no.)(nest)(optimize)
        132                     
        133                     SUBROUTINE pinter(Need1,Need2,Ncellx,Ncelly,Ncellz)
        134                     USE slfgrv
        135                     USE mpivar
        136                     
        137                     !***  finest grid pointer : point(NGL) ***
        138                     !*** coasest grid pointer : point(0)   ***
        139                     
        140                     NGL = min0(Ncellx*NSPLTx,Ncelly*NSPLTy,Ncellz*NSPLTz)
        141                     NGL = int(dlog(dble(NGL))/dlog(2.d0)+1.d-3)
        142                     
        143                     
        144                     !*** Unsplit Pointer ***!
        145                     NGcr = max0(NSPLTx,NSPLTy,NSPLTz)
        146                     NGcr = int(dlog(dble(NGcr))/dlog(2.d0)+1.d-3) + 1
        147                     
        148                     point1(1) = 1
        149                     nl = 1
        150                     nx=3; ny=3; nz=3
        151                     2 continue
        152                     point1(nl+1)=point1(nl)+(nx)*(ny)*(nz)
        153                     nx=nx*2-1; ny=ny*2-1; nz=nz*2-1
        154                     nl = nl+1
        155                     if(nl.ne.NGcr+1) goto 2
        156                     
        157                     Need1 = point1(NGcr+1)
        158                     
        159                     !*** MPI Split Pointer ***!
        160                     nl = NGcr-1
        161                     !nl = NGcr !===================????==================
        162                     point2(nl) = 1
        163                     nx=(2**NGcr)/NSPLTx+2; ny=(2**NGcr)/NSPLTy+2; nz=(2**NGcr)/NSPLTz+2
        164                     3 continue
        165                     point2(nl+1)=point2(nl)+(nx)*(ny)*(nz)
        166                     nx=nx*2-2; ny=ny*2-2; nz=nz*2-2
        167                     nl = nl+1
        168                     if(nl.ne.NGL+1) goto 3
        169                     
        170                     Need2 = point2(NGL+1)
        171                     
        172                     if(NRANK.eq.0) write(*,*) 'NGL=',NGL
        173                     if(NRANK.eq.0) write(*,*) 'NGcr=',NGcr
        174                     if(NRANK.eq.0) write(*,*) 'need1=',Need1
        175                     if(NRANK.eq.0) write(*,*) 'need2=',Need2
        176                     
        177                     END SUBROUTINE pinter

