       5882     4        v        tcd = 0.49d0*(ndH(i,j,k)+ndp(i,j,k)+ndHe(i,j,k)+ndHep(i,j,k)+ndH2(i,j,k))*kb/tcd*(dx(i)**2.d0)
       5883     4        v        tcd = dsign(0.5d0,tcd-dt)
       5884     4        v        U(i,j,k,5) = U(i,j,k,5) + (tcd+0.5d0)*gammi1*dt*0.5d0* &
       5885     4                 ( (Qx(i,j,k)-Qx(i-1,j,k))/dx(i) + (Qy(i,j,k)-Qy(i,j-1,k))/dy(j) + (Qz(i,j,k)-Qz(i,j,k-1))/dz(k) )
       5886     4        v        U(i,j,k,5) = dmax1(U(i,j,k,5),pmin)
       5887     4        v        U(i,j,k,5) = dmin1(U(i,j,k,5),pmax)
       5888     4        v        U(i,j,k,5) = dmax1(U(i,j,k,5),TCMB*kb*(ndp(i,j,k)+ndH(i,j,k)+ndH2(i,j,k)+ndHe(i,j,k)+ndHep(i,j,k)))
       5889     4        v      end do
