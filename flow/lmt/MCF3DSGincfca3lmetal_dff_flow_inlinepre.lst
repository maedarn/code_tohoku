       5856     4        v      Lamc = Lamc * (1.d0-Sigmo)
       5857     4        v      Lamo = Lamo * (1.d0-Sigmo)
       5858     4        v      Lamd = Lamd * (1.d0-Sigmo)
       5859     4        v      LCOr = LCOr * (1.d0-Sigmo)
       5860     4        v      LCOH = LCOH * (1.d0-Sigmo)
       5861     4        v      LCOH2 = LCOH2 * (1.d0-Sigmo)
