       2033     4        v        gammi1 = ( 2.d0*(ndH(i,mnum,lnum)+ndp(i,mnum,lnum)+ndHe(i,mnum,lnum)+ndHep(i,mnum,lnum))+2.d0*ndH2(i,mnum,lnum) )/gammi1
