       1922     4                 !SUBROUTINE RIEMAN( uLi1,uLi2,uLi3,uLi4,uRi1,uRi2,uRi3,uRi4,Pai,Vai, itrn )
       1923     4               
       1924     4        v          D1i = QL1
       1925     4        v          V1i = QL2
