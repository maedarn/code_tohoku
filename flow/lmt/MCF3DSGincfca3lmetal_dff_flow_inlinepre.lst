       1934     4               
       1935     4        v          P1i    = P1i + B1i
       1936     4        v          P2i    = P2i + B2i
       1937     4        v          GP1i   = GAMmi1*P1i
       1938     4        v          GP2i   = GAMmi1*P2i
       1939     4        v          GP1B1i = GAMmi3*P1i - GAMmi2*B1i*2.d0
       1940     4        v          GP2B2i = GAMmi3*P2i - GAMmi2*B2i*2.d0
       1941     4               
